// ─────────────────────────────────────────────────────
// Analytics — Landing-page CTA events
// ─────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String // cta_click, template_preview, etc.
  path        String // page URL that emitted the event
  label       String? // optional button label
  destination String? // where the CTA routes
  sessionId   String // ephemeral session id from client
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId])
  @@map("analytics_event")
}

model AiUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_event")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model SecurityAlert {
  id         String                @id @default(cuid())
  severity   SecurityAlertSeverity @default(WARNING)
  status     SecurityAlertStatus   @default(OPEN)
  title      String
  body       String?
  source     String?
  metadata   Json?
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?

  @@index([status, severity, createdAt])
  @@map("security_alert")
}
