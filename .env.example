# ── App ─────────────────────────────────────────────────
NODE_ENV=development
SEED_USER_EMAIL=developer@example.com
SEED_USER_PASSWORD=ChangeMe123!
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://profileai:profileai_secret@localhost:5432/profileai

# ── Auth (BetterAuth) ──────────────────────────────────────
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_minimum_32_chars
BETTER_AUTH_URL=http://localhost:5000
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_minimum_32_chars
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_minimum_32_chars
ACCESS_TOKEN_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=12h
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d

# ── 2FA (AES-256-GCM) ──────────────────────────────────────
# Must be exactly 32 characters
TOTP_ENCRYPTION_KEY=your_32_character_encryption_key!!

# ── Local Browser Worker ───────────────────────────────────
# Opt-in. When false or unset, /api/v1/worker and /ws/worker are unavailable.
WORKER_ENABLED=false
# Optional dedicated key for the generated task-signing keypair. Falls back to
# TOTP_ENCRYPTION_KEY when omitted. Use a 32+ character random secret.
WORKER_KEY_ENCRYPTION_SECRET=

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenRouter AI ─────────────────────────────────────────
OpenRouter_API_KEY=sk-or-v1-your_openrouter_api_key

# ── Puppeteer PDF Service ───────────────────────────────────
PUPPETEER_SERVICE_URL=http://localhost:3001

# ── MinIO Object Storage ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=profileai
MINIO_USE_SSL=false
# Set to `true` to boot the dev server without connecting to MinIO.
# Any code path that actually uploads/fetches objects will return 503.
SKIP_MINIO=false

# ── Email / SMTP ────────────────────────────────────────────
EMAIL_SENDER_SMTP_HOST=localhost
EMAIL_SENDER_SMTP_PORT=1025
EMAIL_SENDER_SMTP_USER=noreply@profileai.com
# Local MailHog/Mailpit on :1025 does not require auth.
# Set EMAIL_SENDER_SMTP_PASS to a real password when switching to a production SMTP provider.
# EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_FROM=ProFile AI <noreply@profileai.com>

# ── Cloudinary ──────────────────────────────────────────────────────────────────────────────
# Get credentials at https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication integrations (server-only secrets)
IMGBB_API_KEY=your_imgbb_api_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Hybrid Harness Google OAuth. Use one web client with this exact callback.
HARNESS_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
HARNESS_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
HARNESS_GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/harness/google/callback
# Existing career integration can share this 64-character hex AES key.
CAREER_TOKEN_KEY=replace_with_64_hex_characters
# Comma-separated exact Chrome/Edge extension origins after installation.
BROWSER_COMPANION_ORIGINS=chrome-extension://aokpbglhlhigemamdkgbhenaciopnbkk

# ── bKash Tokenized Checkout ─────────────────────────────
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production: use the exact base URL supplied in your bKash merchant onboarding.
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
